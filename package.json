{
  "name": "mandato",
  "version": "0.1.0",
  "private": true,
  "description": "Mandato: an accounts-payable agent that pays what the company signed for and asks a human for everything else.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mandato/api --filter @mandato/web dev",
    "build": "pnpm -r --filter=!@mandato/dataset build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "pnpm --filter @mandato/api eval",
    "dataset:generate": "pnpm --filter @mandato/dataset generate",
    "extractions:record": "pnpm --filter @mandato/api extractions:record",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
