# Copy to .env at the repository root (the API and its scripts read it) and adjust.

# --- API (apps/api) ---------------------------------------------------------
PORT=4100
# PostgreSQL. Leave empty to use PGlite persisted under DATA_DIR (no Docker needed).
DATABASE_URL=
DATA_DIR=./.data/radar
# Raw captures (packages/sources/scripts/capture.mjs) and recorded model answers.
RAW_DIR=./data/raw
LLM_CACHE_DIR=./data/llm-cache
# The frozen demo week, loaded into an empty database when DEMO_MODE is on.
SNAPSHOT_DIR=./data/snapshot
DEMO_MODE=true
# Followed topics (Vigía) search on their own while the API runs. Off by default in the demo,
# so the frozen week does not move; «Buscar ahora» still works.
# WATCH_SCHEDULER=false
# auto: recorded answers first, then the live model. replay: recorded answers only (no network).
LLM_MODE=auto
# DeepSeek V4.1 Flash on Fireworks labels pieces and writes; qwen3 embeddings cluster topics.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
EMBEDDING_MODEL=accounts/fireworks/models/qwen3-embedding-8b
# Optional: LinkedIn search by keyword through Apify (USD 0.002 per post).
APIFY_TOKEN=
# Optional: JEV (TypeSafe) decides whether a piece is about a followed topic and its fit with 30X,
# in milliseconds and at USD 0.042 per million input tokens. Without it, keywords decide.
TYPESAFE_API_KEY=
# The only origin CORS answers.
PUBLIC_WEB_URL=http://localhost:3300
# Bearer token (16+ characters) for pipeline runs, the snapshot export and deletes. Without it
# those routes answer 403 while DEMO_MODE is on. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# --- Web (apps/web) ---------------------------------------------------------
# Where Next.js proxies /api/* (server-side only).
API_URL=http://localhost:4100

# --- MCP server (apps/mcp) ----------------------------------------------------
RADAR_API_URL=http://localhost:4100
