# Copy to .env at the repository root (the API and its scripts read it) and adjust.

# --- API (apps/api) ---------------------------------------------------------
PORT=4000
# PostgreSQL. Leave empty to use PGlite persisted under DATA_DIR (no Docker needed).
DATABASE_URL=
DATA_DIR=./.data
# A language model reads new uploads and compiles rules written in Spanish. Set one key: Claude,
# or any OpenAI-compatible endpoint (DeepSeek V4.1 Flash on Fireworks by default). Without a key
# the API replays the dataset's recorded readings and escalates any other document as
# unreadable (deny-by-default).
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# auto prefers Anthropic when both keys are set; anthropic or fireworks force one.
LLM_PROVIDER=auto
# Which reader serves documents: auto (recorded readings, plus the language model live when a key
# is set) or reference (the dataset's ground truth; development and evaluation only).
READER=auto
# Claude's model and effort, when ANTHROPIC_API_KEY is the one in use.
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium
# Demo mode: user switcher, seeding and guided months. Never enable it in production.
DEMO_MODE=true
DEMO_PACE_MS=350
# HMAC secret for one-time approval links. Use a long random value outside local development.
APPROVAL_LINK_SECRET=change-me-to-a-long-random-secret
APPROVAL_LINK_TTL_MINUTES=1440
PUBLIC_WEB_URL=http://localhost:3000
# Optional: override the demo key of the external "Agente de compras".
AGENT_DEMO_KEY=

# --- Web (apps/web) ---------------------------------------------------------
# Where Next.js proxies /api/* (server-side only).
API_URL=http://localhost:4000

# --- MCP server (apps/mcp) ----------------------------------------------------
MANDATO_API_URL=http://localhost:4000
MANDATO_AGENT_KEY=mnd_demo_agente_compras_2026
