{
  "name": "@radar/api",
  "version": "0.1.0",
  "private": true,
  "description": "Radar HTTP API: collection, enrichment, topics, scores, explanations, adaptations, the sensor and the MCP gateway.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "radar": "tsx src/scripts/pipeline.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@radar/core": "workspace:*",
    "@radar/sources": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.13",
    "@typesafe-ai/sdk": "0.7.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2"
  }
}
